{% extends 'base.html.twig' %}

{% block title %}Gembundles{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col py-10">
    <div class="container mx-auto px-4 flex-1">

        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="w-full text-sm text-left border">
                <thead class="text-xs text-white uppercase bg-emerald-500">
                    <tr>
                        <th class="px-6 py-3">ID</th>
                        <th class="px-6 py-3">Name</th>
                        <th class="px-6 py-3">Description</th>
                        <th class="px-6 py-3">Stock</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Image</th>
                        <th class="px-6 py-3">Created At</th>
                        <th class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for bundle in gembundles %}
                        <tr class="bg-white border-b hover:bg-gray-50 break-words text-forest">
                            <td class="px-6 py-4">{{ bundle.id }}</td>
                            <td class="px-6 py-4">{{ bundle.name }}</td>
                            <td class="px-6 py-4">{{ bundle.description }}</td>
                            <td class="px-6 py-4">{{ bundle.stock }}</td>
                            <td class="px-6 py-4">{{ bundle.price }}</td>
                            <td class="px-6 py-4">
                            {% if bundle.image %}
                                <img src="{{ asset(bundle.image) }}"
                                    alt="{{ bundle.name }}"
                                    class="h-16 w-16 object-cover rounded">
                            {% else %}
                                <span class="text-gray-400 italic">No image</span>
                            {% endif %}
                            </td>

                            <td class="px-6 py-4">{{ bundle.createdAt|date('Y-m-d') }}</td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="{{ path('app_gembundles_show', {'id': bundle.id}) }}" class="text-blue-600 hover:underline">Show</a>
                                <a href="{{ path('app_gembundles_edit', {'id': bundle.id}) }}" class="text-green-600 hover:underline">Edit</a>
                                <form method="post" action="{{ path('app_gembundles_delete', {'id': bundle.id}) }}" style="display:inline" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bundle.id) }}">
                                    <button type="submit" class="text-red-600 hover:underline">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="px-6 py-4 text-center text-gray-600">No bundles found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6">
            <a href="{{ path('app_gembundles_new') }}" class="px-4 py-2 bg-green-600 text-white rounded">
                Create New Bundle
            </a>
        </div>
    </div>
</div>
{% endblock %}
