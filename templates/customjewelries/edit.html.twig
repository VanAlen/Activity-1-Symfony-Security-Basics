{% extends 'base.html.twig' %}

{% block title %}Edit Custom Jewelry{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-semibold text-gray-800 mb-10 text-left">Edit Custom Jewelry</h1>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 px-4 py-2 rounded text-white {{ label == 'success' ? 'bg-green-500' : 'bg-red-500' }}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10 text-forest">
      
      <!-- Image Preview -->
      <div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0">
        {% if customjewelry.imagepath %}
                <img src="{{ asset(customjewelry.imagepath) }}" alt="Jewelry Image" class="w-48 h-48 object-cover rounded-lg">
            {% else %}
                <span class="text-gray-400 italic">No image available</span>
            {% endif %}
      </div>

      <!-- Form Fields -->
      <div class="md:w-2/3 text-forest">
        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-forest">
      {{ form_row(form.gemtype, {'row_attr': {'class': 'mb-6'}}) }}
      {{ form_row(form.jewelrytype, {'row_attr': {'class': 'mb-6'}}) }}
      {{ form_row(form.notes, {'row_attr': {'class': 'mb-6'}}) }}
      {{ form_row(form.imagepath, {'row_attr': {'class': 'mb-6'}}) }}

        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
          <button type="submit" class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Update</button>
          <a href="{{ path('app_customjewelries_index') }}" class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">Back to list</a>
          <form method="post"
                action="{{ path('app_customjewelries_delete', {'id': customjewelry.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customjewelry.id) }}">
            <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700">Delete</button>
          </form>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
