{% extends 'base.html.twig' %}

{% block title %}Create New Custom Jewelry{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col py-20">
    <div class="container mx-auto px-4 py-10 flex-1">
        <h1 class="text-3xl font-bold mb-6 text-gray-800 text-center">
            Create New Custom Jewelry
        </h1>

        <div class="bg-white shadow-md rounded-lg p-6 text-forest">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-forest">
                {{ form_row(form.gemtype, {'attr': {'class': 'border rounded p-2 w-full'}}) }}
                {{ form_row(form.jewelrytype, {'attr': {'class': 'border rounded p-2 w-full'}}) }}
                {{ form_row(form.notes, {'attr': {'class': 'border rounded p-2 w-full h-32'}}) }}
                {{ form_row(form.imagepath, {'attr': {'class': 'border rounded p-2 w-full'}}) }}
                
            </div>

            <div class="mt-6 flex space-x-3">
                <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                    Create
                </button>
                <a href="{{ path('app_jewelries_index') }}" class="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">
                    Back to list
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
