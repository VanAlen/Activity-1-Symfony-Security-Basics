{% extends 'base.html.twig' %}

{% block title %}Edit Product{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-semibold text-gray-800 mb-10 text-left">Edit Gem</h1>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 px-4 py-2 rounded text-white {{ label == 'success' ? 'bg-green-500' : 'bg-red-500' }}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10">
      
      <!-- Image Preview -->
      <div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0">
        {% if product.imagepath %}
        <img src="{{ asset(product.imagepath? 'images/gems/' ~ product.imagepath: 'images/default-gem.webp') }}"
     alt="{{ product.imagepath }}"class="w-[500px] h-auto object-cover rounded-lg shadow-md">

        {% else %}
          <img src="{{ asset('images/default-jewelry.webp') }}" alt="No image" class="w-[500px] h-auto object-cover rounded-lg shadow-md opacity-50">
        {% endif %}
        
      </div>

      <!-- Form Fields -->
      <div class="md:w-2/3 text-forest">
        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {{ form_row(form.gemtype) }}
          {{ form_row(form.carat) }}
          {{ form_row(form.size) }}
          {{ form_row(form.cut) }}
          {{ form_row(form.color) }}
          {{ form_row(form.clarity) }}
          {{ form_row(form.origin) }}
          {{ form_row(form.description) }}
          {{ form_row(form.stock) }}
          {{ form_row(form.price) }}
          {{ form_row(form.imagepath) }}
        </div>

         <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
          <button type="submit"
                  class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
            Update
          </button>

          <a href="{{ path('app_product_index') }}"
             class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">
            Back to list
          </a>

          <form method="post"
                action="{{ path('app_product_delete', {'id': product.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
            <button type="submit"
                    class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700">
              Delete
            </button>
          </form>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
