{% extends 'base.html.twig' %}

{% block title %}Product Details{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-20">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-semibold text-gray-800 mb-10 text-left">Gem Details</h1>

    <div class="bg-white shadow-lg rounded-xl p-8 flex flex-col md:flex-row md:space-x-10">
    
    <!-- Gem Image -->
<div class="md:w-1/3 flex justify-center items-center mb-8 md:mb-0 text-forest">
<img src="{{ asset(product.imagepath ? 'images/gems/' ~ product.imagepath : 'images/default-gem.webp') }}"
     alt="{{ product.description }}"
     class="w-[500px] h-auto object-cover rounded-lg shadow-md">


</div>



      <!-- Gem Info -->
      <div class="md:w-2/3">
        <table class="w-full text-sm md:text-base text-forest">
          <tbody>
            {% for label, value in {
              'ID': product.id,
              'Gem Type': product.gemtype,
              'Carat': product.carat,
              'Size': product.size,
              'Cut': product.cut,
              'Color': product.color,
              'Clarity': product.clarity,
              'Origin': product.origin,
              'Description': product.description,
              'Stock': product.stock,
              'Price': product.price
            } %}
              <tr class="border-b">
                <th class="py-3 px-4 text-gray-500 font-medium w-1/3">{{ label }}</th>
                <td class="py-3 px-4">{{ value }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

       <!-- Actions -->
 <!-- Actions -->
        <div class="mt-8 flex flex-wrap gap-4">
          <!-- Update -->
          <a href="{{ path('app_product_edit', {'id': product.id}) }}"
            class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
            Edit
          </a>

          <!-- Back to list -->
          <a href="{{ path('app_product_index') }}"
            class="px-5 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">
            Back to list
          </a>

          <!-- Delete -->
          <form method="post"
                action="{{ path('app_product_delete', {'id': product.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
            <button type="submit"
                    class="px-5 py-2 bg-red-600 text-white rounded hover:bg-red-700">
              Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
