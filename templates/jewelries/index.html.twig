{% extends 'base.html.twig' %}

{% block title %}Jewelries{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col py-10">
    <div class="container mx-auto px-4  flex-1">

        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
            <table class="w-full text-sm text-left border">
                <thead class="text-xs text-biege uppercase bg-emerald-500">
                    <tr>
                        <th class="px-6 py-3">ID</th>
                        <th class="px-6 py-3">Name</th>
                        <th class="px-6 py-3">Gem Type</th>
                        <th class="px-6 py-3">Jewelry Type</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Stock</th>
                        <th class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {% for jewelry in jewelries %}
                        <tr class="bg-white border-b hover:bg-gray-50 break-words text-forest">
                            <td class="px-6 py-4">{{ jewelry.id }}</td>
                            <td class="px-6 py-4">{{ jewelry.name }}</td>
                            <td class="px-6 py-4">{{ jewelry.gemtype }}</td>
                            <td class="px-6 py-4">{{ jewelry.jewelrytype }}</td>
                            <td class="px-6 py-4">{{ jewelry.price }}</td>
                            <td class="px-6 py-4">{{ jewelry.stock }}</td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="{{ path('app_jewelries_show', {'id': jewelry.id}) }}" class="text-blue-600 hover:underline">Show</a>
                                <a href="{{ path('app_jewelries_edit', {'id': jewelry.id}) }}" class="text-green-600 hover:underline">Edit</a>
                                <form method="post" action="{{ path('app_jewelries_delete', {'id': jewelry.id}) }}" style="display:inline" onsubmit="return confirm('Are you sure?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jewelry.id) }}">
                                    <button type="submit" class="text-red-600 hover:underline">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-4 text-center">No jewelries found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6">
        <a href="{{ path('app_jewelries_new') }}"
            class="flex items-center px-4 py-2  text-black rounded ">
            <img src="{{ asset('images/icon/add.ico') }}"
                alt="Add Icon"
                class="w-5 h-5 mr-2">
            Create New Jewelry
        </a>
        </div>
    </div>
</div>
{% endblock %}
